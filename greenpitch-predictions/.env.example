# Copy this file to .env and replace both values with unique random secrets.
FOOTBALL_DATA_API_KEY=
SESSION_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_TOKEN=replace-with-a-separate-long-random-token

# Optional settings
APP_PORT=8000
SESSION_HTTPS_ONLY=false
LOG_LEVEL=INFO
# Optional exact username of an existing active account to promote on startup.
# BOOTSTRAP_ADMIN_USERNAME=happyhusky

# Optional database override. Docker defaults to its persistent SQLite database.
# To use Supabase, set your actual password and URL-encode any reserved characters:
# DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.tyqgbczmvhxrlsjhjzbu.supabase.co:5432/postgres
